{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Keep CI on the minimum supported Python version (3.12)",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    }
  ]
}
